% Macro to set up the header and print instructions in one call
% Usage: \Heading{MainTitle}{SubTitle}{InstructionsText}
\newcommand{\Heading}[3]{%
    % Store the arguments internally for running headers if needed
    \gdef\QuizCourseName{#1}%
    \gdef\QuizTitle{#2}%

    % First-page header
    \firstpageheader
    {\FontEasyRead #1 \\ #2 \\ \vphantom{X}}
    {}
    {\FontEasyRead
        Name:\ \rule[-0.1cm]{5cm}{0.01cm}\\[0.6cm]
        Date:\ \rule[-0.1cm]{5cm}{0.01cm}
    }%

    % Running header for subsequent pages
    \runningheader
    {\FontEasyRead #1\\#2 (cont.)}
    {}
    {}%

    % Instructions block (minipage for spacing control)
    \noindent
    \begin{minipage}{\textwidth}
        \raggedright
        #3\par
        \vspace{-0.3\baselineskip}%
        \noindent\rule{\textwidth}{0.2pt}%
    \end{minipage}%
    \vspace{0.5\baselineskip}%
}

% ------------------------
% Question spacing adjustments
% ------------------------
\newlength{\questiontopsep}
\newlength{\questionbodyskip}
\setlength{\questiontopsep}{5pt}      % space before questions
\setlength{\questionbodyskip}{5pt}    % space after questions
