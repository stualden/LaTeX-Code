% problemset.sty
% General-purpose problem set / quiz / test template
% Stu Alden, revised
% -----------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{problemset}[2026/02/22 v1.0 Problem set template]

% ------------------------
% Load needed packages
% ------------------------
\RequirePackage[margin=1in,includehead,includefoot]{geometry}   % Page layout
\RequirePackage{amsmath}                                        % Math
\RequirePackage{multicol}                                       % Multiple columns utility
\RequirePackage{tikz}                                           % For drawing timelines and diagrams
\usetikzlibrary{shapes,arrows,calc,through,intersections}
\tikzset{
line/.style = {draw, -{Triangle[angle=45]}}
}

% ------------------------
% Font setup - needed because exam class is dumb about font sizes
% ------------------------
\newcommand{\FontEasyRead}{\fontsize{14}{16}\selectfont}

% ------------------------
% Flexible answer space
% Default: 2in, with plus 25% minus 12.5%
% Usage: \AnswerSpace[3in] for custom space
% ------------------------
\newcommand{\AnswerSpace}[1][2in]{%
    \vspace{#1 plus 0.25\dimexpr#1\relax minus 0.125\dimexpr#1\relax}%
}

% ------------------------
% Combine question + answer space
% Optional argument sets answer space (default 2in)
% Usage: \Problem{Question text} or \Problem[3in]{Question text}
% ------------------------
\newcommand{\Problem}[2][2in]{%
    \question #2
    \AnswerSpace[#1]%
}

% ------------------------
% Section headings (optional)
% Optional first argument: extra space before section
% Usage: \ProblemSection{Section title} or \ProblemSection[1cm]{Section title}
% ------------------------
\newcommand{\ProblemSection}[2][0pt]{%
    \vspace{#1}%
    \noindent\textbf{\large #2}%
    \vspace{0.5\baselineskip}%
}

